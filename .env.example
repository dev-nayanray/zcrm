# ─── MongoDB Atlas Connection ───
# Your MongoDB Atlas connection string.
# Replace with your actual connection string from Atlas dashboard.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zcrm?retryWrites=true&w=majority&appName=crm

# ─── Auth Secret ───
# HMAC-SHA256 signing secret for session cookies (≥32 chars).
# Generate your own with: openssl rand -hex 32
AUTH_SECRET=replace-with-openssl-rand-hex-32
